# B- -> D_s*+ K*- mu- nu (4-body semileptonic, PHSP model — no dedicated
# form-factor model exists in EvtGen for this topology).
# Forced chain keeps all final-state particles reconstructable:
#   D_s*+ -> D_s+ gamma, D_s+ -> phi pi+, phi -> K+ K-
#   K*-   -> anti-K0 pi-, anti-K0 -> K_S0 -> pi+ pi-

Alias      B+sig        B+
Alias      B-sig        B-
ChargeConj B+sig        B-sig

Alias      D_s*+sig     D_s*+
Alias      D_s*-sig     D_s*-
ChargeConj D_s*+sig     D_s*-sig

Alias      D_s+sig      D_s+
Alias      D_s-sig      D_s-
ChargeConj D_s+sig      D_s-sig

Alias      phisig       phi
ChargeConj phisig       phisig

Alias      K*+sig       K*+
Alias      K*-sig       K*-
ChargeConj K*+sig       K*-sig

Alias      K0sig        K0
Alias      anti-K0sig   anti-K0
ChargeConj K0sig        anti-K0sig

Alias      K_S0sig      K_S0
ChargeConj K_S0sig      K_S0sig

Decay Upsilon(4S)
0.500  B+sig B-                      VSS;
0.500  B-sig B+                      VSS;
Enddecay

Decay B-sig
1.000  D_s*+sig K*-sig mu- anti-nu_mu   PHSP;
Enddecay
CDecay B+sig

Decay D_s*+sig
1.000  D_s+sig gamma                 VSP_PWAVE;
Enddecay
CDecay D_s*-sig

Decay D_s+sig
1.000  phisig pi+                    SVS;
Enddecay
CDecay D_s-sig

Decay phisig
1.000  K+ K-                         VSS;
Enddecay

Decay K*-sig
1.000  anti-K0sig pi-                VSS;
Enddecay
CDecay K*+sig

Decay anti-K0sig
1.000  K_S0sig                       PHSP;
Enddecay
CDecay K0sig

Decay K_S0sig
1.000  pi+ pi-                       PHSP;
Enddecay

End
